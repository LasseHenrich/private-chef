# Copy to .env, or run `python run.py setup` to generate a private local token.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHEF_API_TOKEN=
CHEF_DB_PATH=data/chef.sqlite3
CHEF_HOST=127.0.0.1
CHEF_PORT=8787
CHEF_USER_1_NAME=Person 1
CHEF_USER_2_NAME=Person 2
# E.164 numbers, for example +491234567890. Leave empty for local-only testing.
CHEF_USER_1_WHATSAPP=
CHEF_USER_2_WHATSAPP=
# For the OpenClaw plugin (same token as above).
CHEF_SERVICE_URL=http://127.0.0.1:8787
